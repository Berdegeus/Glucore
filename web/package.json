{
  "name": "glucore-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dup": "jscpd --config .jscpd.json src",
    "size": "node scripts/checkBundleSize.mjs && node scripts/checkInitialChunks.mjs",
    "chunks": "node scripts/checkInitialChunks.mjs",
    "lighthouse": "npm run build && node scripts/lighthouseLogin.mjs && lhci assert --config=lighthouserc.json"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jscpd": "5.4.0",
    "jsdom": "29.1.1",
    "lighthouse": "12.6.1",
    "msw": "3.0.2",
    "puppeteer-core": "24.43.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vitest-axe": "0.1.0"
  }
}
