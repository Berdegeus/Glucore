# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.fvm/
.pub-cache/
.pub/
/build/
/coverage/
/lib/l10n/generated/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android/Gradle/NDK local files
.gradle/
/android/.gradle/
/android/.cxx/
/android/build/
/android/captures/
/android/local.properties
/android/key.properties
/android/app/src/main/jniLibs/**/*.so
/android/app/src/main/jniLibs/arm64-v8a/*
*.jks
*.keystore

# Node.js / Backend
node_modules/
backend/node_modules/
backend/dist/
backend/.env
*.env
backend/prisma/*.db

# Office lock files (created while a document is open; never a project artifact)
~$*

# Local tooling / assistant context
.claude/

# Test coverage reports
backend/coverage/
backend/dist/
backend/.env.test
backend/**/tsconfig.tsbuildinfo
backend/services/*/dist/
backend/packages/*/dist/
backend/services/*/.env.test

# Prisma clients are generated on install (postinstall), never committed.
# auth-service generates into its own directory because the workspace-wide
# node_modules/.prisma/client is shared and the two services would overwrite
# each other there — see services/auth-service/prisma/schema.prisma.
backend/services/*/generated/
