# The Gradle wrapper (gradlew, gradlew.bat, gradle-wrapper.jar) is committed on
# purpose, against the Flutter template default: without it a clean CI runner has
# nothing to invoke, and the wrapper is what pins the Gradle version for everyone.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
