{
  "name": "glucore-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b packages/shared services/glucose-service",
    "dev": "npm run dev -w @glucore/glucose-service",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:dev": "npm run migrate:dev -w @glucore/glucose-service",
    "migrate:deploy": "npm run migrate:deploy -w @glucore/glucose-service"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
