// Clinical data, and nothing else.
//
// Identity — User, AuthCredential, PasswordResetToken, AuthSession — moved to
// auth-service and its own database. What is left joins to a person only by the
// userId carried in the JWT, which is why `Patient.userId`,
// `HealthProfessional.userId` and `Administrator.userId` are bare UUIDs with no
// relation: the table they pointed at is not in this database any more.
//
// Seventeen of the original twenty foreign keys are still here, and they are the
// ones that matter clinically: sensor -> binding -> patient -> reading stays
// intact and still cascades.
//
// What was given up: ON DELETE CASCADE from User to Patient. This database can
// no longer prevent an orphaned patient, so deleting an account has to become an
// explicit cross-service operation instead of a row deletion.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SensorSessionState {
  IDLE
  CONNECTING
  CONNECTED
  MONITORING
  DISCONNECTED
  ERROR
  READING_UNAVAILABLE
  SENSOR_EXPIRED
}

enum SensorBrand {
  SIBIONICS_BLE
  FREESTYLE_LIBRE
  OTHER_COMPATIBLE
}

enum AlertType {
  HYPO_RISK
  HYPER_RISK
  FAST_DROP
  FAST_RISE
  SENSOR_RECONNECTED
  SYNC_FAILURE
}

model Patient {
  userId                String                 @id @db.Uuid
  birthDate             DateTime?              @db.Date
  diabetesType          String?
  weightKg              Decimal?               @db.Decimal(6, 2)
  targetRangeMin        Int                    @default(80)
  targetRangeMax        Int                    @default(180)
  sensorBindings        SensorBinding[]
  readings              GlucoseReading[]
  alertEvents           AlertEvent[]
  carbs                 CarbEvent[]
  insulin               InsulinEvent[]
  alertThresholdConfig  AlertThresholdConfig?
  clinicalReports       ClinicalReport[]
  dashboardAccessGrants DashboardAccessGrant[]
}

/// roadmap: perfil do profissional de saude. Sem rota nesta release; mantido para o painel clinico planejado.
model HealthProfessional {
  userId                String                 @id @db.Uuid
  licenseNumber         String
  specialty             String
  dashboardAccessGrants DashboardAccessGrant[]
}

/// roadmap: perfil administrativo. Sem rota nesta release; mantido para a gestao de usuarios planejada.
model Administrator {
  userId       String @id @db.Uuid
  employeeCode String
}

/// roadmap: cadastro de aparelho de sensor no servidor. Sem rota nesta release; hoje a sessao do sensor vive no SQLite do Android.
model SensorDevice {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serialNumber    String          @unique
  sensorBrand     SensorBrand
  model           String?
  firmwareVersion String?
  hardwareVersion String?
  isActive        Boolean         @default(true)
  bindings        SensorBinding[]
  sessions        SensorSession[]
}

/// roadmap: vinculo paciente-sensor no servidor. Sem rota nesta release.
model SensorBinding {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String       @db.Uuid
  sensorDeviceId String       @db.Uuid
  boundAt        DateTime     @default(now())
  unboundAt      DateTime?
  isCurrent      Boolean      @default(true)
  patient        Patient      @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  sensorDevice   SensorDevice @relation(fields: [sensorDeviceId], references: [id], onDelete: Cascade)

  @@index([patientId, isCurrent])
  @@index([sensorDeviceId])
}

/// roadmap: sessao de sensor no servidor. Sem rota nesta release; a sessao ativa e mantida pelo app.
model SensorSession {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensorDeviceId String              @db.Uuid
  startedAt      DateTime            @default(now())
  endedAt        DateTime?
  accessCode     String?
  state          SensorSessionState  @default(IDLE)
  lastSeenAt     DateTime?
  sensorDevice   SensorDevice        @relation(fields: [sensorDeviceId], references: [id], onDelete: Cascade)
  readings       GlucoseReading[]
  statusEvents   SensorStatusEvent[]

  @@index([sensorDeviceId, startedAt])
}

/// roadmap: telemetria de status do sensor. Sem rota nesta release.
model SensorStatusEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensorSessionId String        @db.Uuid
  occurredAt      DateTime      @default(now())
  statusCode      String
  message         String
  batteryPct      Int?
  sensorSession   SensorSession @relation(fields: [sensorSessionId], references: [id], onDelete: Cascade)

  @@index([sensorSessionId, occurredAt])
}

model GlucoseReading {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String              @db.Uuid
  sensorSessionId String?             @db.Uuid
  recordedAt      DateTime
  valueMgDl       Int
  trend           String              @default("stable")
  trendRate       Float               @default(0)
  source          String              @default("sensor")
  isManual        Boolean             @default(false)
  alarmCode       Int?
  patient         Patient             @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  sensorSession   SensorSession?      @relation(fields: [sensorSessionId], references: [id])
  predictions     GlucosePrediction[]

  @@unique([patientId, recordedAt])
  @@index([sensorSessionId])
}

model AlertThresholdConfig {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId           String              @unique @db.Uuid
  lowGlucoseMgDl      Int                 @default(80)
  highGlucoseMgDl     Int                 @default(180)
  predictionWindowMin Int                 @default(30)
  updatedAt           DateTime            @updatedAt
  patient             Patient             @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  predictions         GlucosePrediction[]
}

/// roadmap: predicao de glicemia. Sem rota nesta release; AlertEvent.glucosePredictionId fica nulo.
model GlucosePrediction {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  glucoseReadingId       String               @db.Uuid
  alertThresholdConfigId String               @db.Uuid
  predictedAt            DateTime             @default(now())
  horizonMinutes         Int
  predictedMgDl          Int
  confidence             Decimal              @db.Decimal(5, 4)
  glucoseReading         GlucoseReading       @relation(fields: [glucoseReadingId], references: [id], onDelete: Cascade)
  alertThresholdConfig   AlertThresholdConfig @relation(fields: [alertThresholdConfigId], references: [id], onDelete: Cascade)
  alerts                 AlertEvent[]

  @@index([glucoseReadingId])
  @@index([alertThresholdConfigId])
}

model AlertEvent {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId           String             @db.Uuid
  glucosePredictionId String?            @db.Uuid
  triggeredAt         DateTime           @default(now())
  resolvedAt          DateTime?
  alertType           AlertType
  message             String             @default("")
  acknowledged        Boolean            @default(false)
  patient             Patient            @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  glucosePrediction   GlucosePrediction? @relation(fields: [glucosePredictionId], references: [id])

  @@index([patientId, triggeredAt])
  @@index([glucosePredictionId])
}

model CarbEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String   @db.Uuid
  eventAt     DateTime
  carbsGrams  Decimal  @db.Decimal(10, 2)
  description String
  patient     Patient  @relation(fields: [patientId], references: [userId], onDelete: Cascade)

  @@index([patientId, eventAt])
}

model InsulinEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String   @db.Uuid
  eventAt     DateTime
  insulinType String
  doseUnits   Decimal  @db.Decimal(10, 2)
  dayOfWeek   String   @default("")
  description String?
  patient     Patient  @relation(fields: [patientId], references: [userId], onDelete: Cascade)

  @@index([patientId, eventAt])
}

/// roadmap: relatorio clinico gerado. Sem rota nesta release.
model ClinicalReport {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId             String                 @db.Uuid
  generatedAt           DateTime               @default(now())
  fromDate              DateTime
  toDate                DateTime
  periodLabel           String
  patient               Patient                @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  metricsSnapshots      MetricsSnapshot[]
  dashboardAccessGrants DashboardAccessGrant[]

  @@index([patientId, generatedAt])
}

/// roadmap: metricas agregadas de um relatorio clinico. Sem rota nesta release.
model MetricsSnapshot {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalReportId String         @db.Uuid
  periodStart      DateTime
  periodEnd        DateTime
  avgGlucose       Decimal        @db.Decimal(8, 2)
  timeInRangePct   Decimal        @db.Decimal(5, 2)
  hypoPercent      Decimal        @db.Decimal(5, 2)
  hyperPercent     Decimal        @db.Decimal(5, 2)
  gmi              Decimal        @db.Decimal(5, 2)
  clinicalReport   ClinicalReport @relation(fields: [clinicalReportId], references: [id], onDelete: Cascade)

  @@index([clinicalReportId])
}

/// roadmap: consentimento de acesso do profissional ao painel do paciente. Sem rota nesta release.
model DashboardAccessGrant {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId            String             @db.Uuid
  healthProfessionalId String             @db.Uuid
  clinicalReportId     String?            @db.Uuid
  grantedAt            DateTime           @default(now())
  expiresAt            DateTime?
  permissionLevel      String
  patient              Patient            @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  healthProfessional   HealthProfessional @relation(fields: [healthProfessionalId], references: [userId], onDelete: Cascade)
  clinicalReport       ClinicalReport?    @relation(fields: [clinicalReportId], references: [id])

  @@index([patientId])
  @@index([healthProfessionalId])
  @@index([clinicalReportId])
}

/// Trilha de auditoria (item 4.11 do checklist), das escritas clínicas —
/// leituras, carboidratos, insulina, alertas e thresholds. As ações de conta
/// (LOGIN, REGISTER, RESET_PASSWORD) são gravadas na tabela equivalente do
/// auth-service.
///
/// `userId` continua nulável mas já não tem FK: não existe `User` neste banco
/// para referenciar. O efeito prático do antigo `onDelete: SetNull` — a trilha
/// sobreviver à exclusão da conta — vale de graça agora, já que nada apaga
/// estas linhas em cascata.
///
/// `metadata` nunca recebe senha, hash de senha ou token de recuperação.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  entity    String
  action    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, createdAt])
}
