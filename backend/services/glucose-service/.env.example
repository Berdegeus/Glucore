DATABASE_URL="postgresql://YOUR_USER@localhost:5432/glucore_dev?schema=public"
JWT_SECRET="change-me-before-production"

# Signs/verifies the x-internal-token the gateway sends on every proxied
# request. Must be distinct from JWT_SECRET and shared with the gateway and
# auth-service — a mismatch makes every /internal/* call answer 401.
INTERNAL_JWT_SECRET="change-me-before-production-internal"
PORT=3001

# Comma-separated allowed origins. Required when NODE_ENV=production — an
# empty value there is a startup error, not "allow everything".
# CORS_ORIGIN=https://app.example.com

# SMTP — leave blank to skip email sending (token printed to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
