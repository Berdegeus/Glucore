# Copy to .env.test and point at a throwaway database whose name contains "_test".
# The suite TRUNCATEs every table between cases.
#
# This is a different database from glucose-service's: the whole point of the
# split is that identity and clinical data do not share one.
#
# The name is TEST_AUTH_DATABASE_URL, not TEST_DATABASE_URL: both services'
# .env.test files load into the same process when the root runs both suites,
# and a shared name would point the two suites at one database.
TEST_AUTH_DATABASE_URL="postgresql://USER@localhost:5432/glucore_auth_test?schema=public"
