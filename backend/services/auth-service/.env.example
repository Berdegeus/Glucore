DATABASE_URL="postgresql://YOUR_USER@localhost:5432/glucore_auth_dev?schema=public"
JWT_SECRET="change-me-before-production"
PORT=3002

# Comma-separated allowed origins. Required when NODE_ENV=production — an
# empty value there is a startup error, not "allow everything".
# CORS_ORIGIN=https://app.example.com

# bcrypt work factor. 12 in production; the test container injects 4, since a
# realistic factor costs ~300 ms per password and dominates the suite.
BCRYPT_ROUNDS=12

# SMTP — leave SMTP_HOST blank to use the console mailer, which prints the reset
# token instead of sending it. That choice is made by configuration, not by
# catching a send failure: with a host set, a delivery error stays an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
