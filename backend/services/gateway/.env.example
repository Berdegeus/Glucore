PORT=3000

# Verifies the end-user Bearer token. Same secret auth-service signs with.
JWT_SECRET="change-me-before-production"

# Signs the x-internal-token forwarded to auth-service and glucose-service.
# Must be distinct from JWT_SECRET and shared with both downstream services —
# a mismatch makes every /internal/* call answer 401.
INTERNAL_JWT_SECRET="change-me-before-production-internal"

# Comma-separated allowed origins. Required when NODE_ENV=production — an
# empty value there is a startup error, not "allow everything".
# CORS_ORIGIN=https://app.example.com

# Fixed URLs until phase 5 replaces this with Consul-backed discovery.
AUTH_SERVICE_URL=http://localhost:3002
GLUCOSE_SERVICE_URL=http://localhost:3001
