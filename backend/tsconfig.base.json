{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Required for project references: each workspace emits .d.ts + build info
    // so `tsc -b` can order builds and skip unchanged projects. This is what
    // lets services depend on packages/shared by package name and still get
    // type errors across the boundary.
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
