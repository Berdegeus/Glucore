# Copie para deploy/.env.prod na VM (nunca versionar o arquivo preenchido).
# Gere cada segredo com: openssl rand -hex 32
# Os valores são hex de propósito: a senha do Postgres entra em uma URL.

# Host público do gateway, sem https:// (ex.: glucore-xyz.duckdns.org)
API_HOST=

# Origens permitidas no CORS (obrigatória em produção): lista separada por
# vírgula, sem espaço obrigatório e sem barra final. Ponha as duas:
#   1. a URL pública da API (a mesma de API_HOST, com https://);
#   2. a origem da web na Vercel (ex.: https://glucore-web.vercel.app).
# O app mobile não envia Origin, então não precisa estar na lista. As URLs de
# preview da Vercel (https://<projeto>-<hash>-<time>.vercel.app) ficam de fora
# de propósito: só a origem de produção fala com a API.
CORS_ORIGIN=https://SEU-HOST,https://glucore-web.vercel.app

POSTGRES_PASSWORD=
JWT_SECRET=
# Precisa ser diferente do JWT_SECRET.
INTERNAL_JWT_SECRET=

# SMTP: sem os três campos o auth-service imprime o token de reset no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Primeiro administrador: criado no boot do auth-service só quando ainda não há
# nenhum (nunca duplica nem redefine a senha). Obrigatórias na primeira subida em
# produção; a senha precisa ser forte (mínimo 8 caracteres com maiúscula,
# minúscula, dígito e caractere especial), senão o serviço não sobe e a mensagem
# nomeia a variável. Depois da primeira subida a senha pode ser removida daqui.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
